#!/bin/bash -eu
# Signs an unsigned release APK, publishes it as a GitHub release and builds
# the F-Droid repo (deployed to GitHub Pages by the workflow).
# Run by .github/workflows/fork_build.yml on master. See FORK.md.
#
# Usage: ci/fork-release <unsigned.apk>
# Env:   SIGNING_PASSWORD, GH_TOKEN

UNSIGNED_APK="$1"
KEYSTORE="signing/release.p12"
KEY_ALIAS="release"

if [ "${#SIGNING_PASSWORD}" -lt 32 ]; then
  echo "::error::SIGNING_PASSWORD secret is missing or shorter than 32 characters. See FORK.md."
  exit 1
fi

BUILD_TOOLS="$(ls -d "$ANDROID_HOME"/build-tools/* | sort -V | tail -n 1)"

VERSION="$("$BUILD_TOOLS/aapt2" dump badging "$UNSIGNED_APK" | sed -n "s/.* versionName='\([^']*\)'.*/\1/p")"
if ! [[ "$VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "::error::Unexpected version name '$VERSION'"
  exit 1
fi
TAG="v$VERSION"

if gh release view "$TAG" >/dev/null 2>&1; then
  echo "::notice::$TAG is already released, nothing to publish. Bump forkBuild in fork.properties for a new release."
  exit 0
fi

if [ ! -f "$KEYSTORE" ]; then
  # Only ever create a key for the very first release. A new key means the
  # installed app can no longer be updated, so never do that silently.
  if [ -n "$(gh release list --limit 1 --json tagName --jq '.[].tagName')" ]; then
    echo "::error::$KEYSTORE is missing but releases exist. Restore it from git history; do not create a new key."
    exit 1
  fi
  echo "Creating signing key $KEYSTORE"
  mkdir -p "$(dirname "$KEYSTORE")"
  keytool -genkeypair -noprompt \
    -keystore "$KEYSTORE" -storetype PKCS12 -storepass:env SIGNING_PASSWORD \
    -alias "$KEY_ALIAS" -keyalg RSA -keysize 4096 -validity 36500 \
    -dname "CN=Feeder fork"
  git config user.name "github-actions[bot]"
  git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
  git add "$KEYSTORE"
  git commit -m "chore: added release signing key (password protected)"
  git push origin HEAD:master
fi

SIGNED_APK="feeder-$VERSION.apk"
"$BUILD_TOOLS/apksigner" sign \
  --ks "$KEYSTORE" --ks-pass env:SIGNING_PASSWORD --ks-key-alias "$KEY_ALIAS" \
  --out "$SIGNED_APK" "$UNSIGNED_APK"

CERT_SHA256="$("$BUILD_TOOLS/apksigner" verify --print-certs "$SIGNED_APK" | sed -n 's/^Signer #1 certificate SHA-256 digest: //p')"
if [ -z "$CERT_SHA256" ]; then
  echo "::error::Could not verify the signed APK"
  exit 1
fi
APK_SHA256="$(sha256sum "$SIGNED_APK" | cut -d ' ' -f 1)"

# Built before publishing anything so a failure leaves no half-done release
ci/fork-fdroid-repo "$SIGNED_APK" site
OWNER="${GITHUB_REPOSITORY%%/*}"
FDROID_REPO_URL="https://${OWNER,,}.github.io/${GITHUB_REPOSITORY#*/}/repo"

gh release create "$TAG" "$SIGNED_APK" \
  --target "$GITHUB_SHA" \
  --title "Feeder $VERSION" \
  --generate-notes \
  --notes "Signing certificate SHA-256: \`$CERT_SHA256\`
APK SHA-256: \`$APK_SHA256\`
F-Droid repository: $FDROID_REPO_URL?fingerprint=$CERT_SHA256
"
echo "published=true" >> "$GITHUB_OUTPUT"
echo "::notice::Published $TAG (certificate SHA-256 $CERT_SHA256)"
